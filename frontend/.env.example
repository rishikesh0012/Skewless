# Base URL of the FastAPI backend. Vite inlines this at build time.
#
# Local dev (npm run dev / docker compose): the default in src/lib/api.ts
# already matches this value, so this file is documentation, not required.
#
# Vercel: set the equivalent as a real Environment Variable in the project
# settings — pointing at the deployed Render backend URL — not in a committed
# file. See the "Deploy" section in README.md.
VITE_API_BASE_URL=http://localhost:8000
